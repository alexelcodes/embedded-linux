{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Copy built to RPi (scp)",
      "type": "shell",
      "command": "scp",
      "args": ["${command:cmake.launchTargetPath}", "rpi:~"],
      "problemMatcher": []
    },
    {
      "label": "Run on RPi (ssh)",
      "type": "shell",
      "command": "ssh",
      "args": ["rpi", "\"~/${command:cmake.launchTargetFilename}\""],
      "problemMatcher": [],
      "dependsOn": "Copy built to RPi (scp)"
    }
  ]
}
